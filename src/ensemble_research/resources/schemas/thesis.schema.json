{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investment thesis",
  "description": "A thesis is only complete when it can be proven wrong. Falsification is required, not optional.",
  "type": "object",
  "required": ["direction", "statement", "consensus", "variant_view", "layer", "variables",
               "falsification", "judgment", "time_horizon"],
  "properties": {
    "schema_version": {"type": "string"},
    "kind": {"const": "thesis"},
    "direction": {"type": "string"},
    "statement": {"type": "string", "minLength": 40},
    "consensus": {"type": "string", "minLength": 30,
      "description": "What the market likely already believes. Mark as assumed if unverified."},
    "consensus_verified": {"type": "boolean"},
    "variant_view": {"type": "string", "minLength": 40},
    "layer": {"type": "string", "description": "Which value-chain layer the view attaches to."},
    "time_horizon": {"type": "string"},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "falsification": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 25}},
    "quality_lens": {
      "type": "object",
      "properties": {
        "circle_of_competence": {"enum": ["inside", "edge", "outside", "unknown"]},
        "moat_source": {"type": "string"},
        "moat_trend": {"enum": ["widening", "stable", "narrowing", "unknown"]},
        "pricing_power": {"type": "string"},
        "capital_intensity": {"type": "string"},
        "five_year_closure_test": {"type": "string"},
        "ruin_risk": {"type": "string"},
        "implication": {"enum": ["upgrade", "neutral", "downgrade", "pass"]},
        "evidence_needed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "valuation_reference": {"type": "object",
      "description": "Metric values with method tags, copied from valuation.json / percentile.json."},
    "judgment": {"enum": ["A. Discard", "B. Watch", "C. Deep Dive", "D. Potential Investment Thesis"]},
    "judgment_rationale": {"type": "string", "minLength": 40},
    "source_ids": {"type": "array", "items": {"type": "string"}}
  }
}
