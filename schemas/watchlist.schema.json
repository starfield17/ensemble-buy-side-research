{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data watchlist",
  "type": "object",
  "required": ["items"],
  "properties": {
    "schema_version": {"type": "string"},
    "kind": {"const": "watchlist"},
    "direction": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variable", "why_it_matters", "source", "frequency",
                     "bullish_threshold", "bearish_threshold"],
        "properties": {
          "thesis_driver": {"type": "string"},
          "variable": {"type": "string"},
          "why_it_matters": {"type": "string", "minLength": 20},
          "source": {"type": "string"},
          "frequency": {"type": "string"},
          "bullish_threshold": {"type": "string", "minLength": 5,
            "description": "Specific enough that someone else could check it without asking you."},
          "bearish_threshold": {"type": "string", "minLength": 5},
          "current_reading": {"type": "string"},
          "next_check": {"type": "string"},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "status_rules": {
      "type": "object",
      "properties": {
        "upgrade_if": {"type": "string"},
        "downgrade_if": {"type": "string"},
        "abandon_if": {"type": "string"}
      }
    }
  }
}
